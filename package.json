{
  "name": "khqrpay",
  "version": "0.1.1",
  "description": "Official KHQRPay SDK for Node.js: accept KHQR payments in Cambodia from ABA, ACLEDA, Wing and every Bakong app, and verify signed webhooks.",
  "keywords": [
    "khqr",
    "khqrpay",
    "bakong",
    "cambodia",
    "payments",
    "qr payment",
    "aba",
    "acleda",
    "wing",
    "riel",
    "webhook",
    "payment gateway"
  ],
  "homepage": "https://khqrpay.dev/guides/khqr-api-nodejs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaraXBT/khqrpay-node.git"
  },
  "bugs": {
    "url": "https://github.com/DaraXBT/khqrpay-node/issues"
  },
  "license": "MIT",
  "author": "KHQRPay (https://khqrpay.dev)",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/cjs-names.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
